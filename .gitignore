# Local tools and the single WSL environment
.tools/
.venv/
.cache/
__pycache__/
*.py[cod]

# Large research trees are ignored by default; selected readable evidence is tracked explicitly.
# Full scientific files, including upstream checkout and weights, are preserved in a private Release.
third_party/
data/
artifacts/
*.ckpt
*.pth
*.pt

# Credentials must never enter Git or research archives.
.env
.env.*
!.env.example
*.pem
*.key

